generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                 String                @id @default(cuid())
  email              String                @unique
  firstName          String
  lastName           String
  displayName        String
  passwordHash       String
  /// Compte de SERVICE (le pont MCP incarne « IA »), pas un humain.
  /// Un compte de service voit les pages privées des espaces où il est MEMBRE :
  /// sans ça, un board posé sur une page privée lui répond 404 et l'automatisation
  /// est muette. L'exemption s'arrête là — elle ne franchit aucune frontière
  /// d'espace, et aucune route de l'API n'expose ce champ en écriture.
  isService          Boolean               @default(false)
  createdAt          DateTime              @default(now())
  sessions           Session[]
  memberships        Membership[]
  sentInvitations    WorkspaceInvitation[] @relation("InvitationAuthor")
  pageVisits         PageVisit[]
  ownedPages         Page[]                @relation("PageOwner")
  records            Record[]
  recordRevisions    RecordRevision[]
  attachments        RecordAttachment[]
  comments           RecordComment[]
  notifications      Notification[]        @relation("NotificationRecipient")
  notificationsActed Notification[]        @relation("NotificationActor")
}

model Session {
  // id = sha256(token) — le token vit en clair dans le cookie, jamais en base.
  id                 String     @id @default(cuid())
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt          DateTime
  createdAt          DateTime   @default(now())
  currentWorkspaceId String?
  currentWorkspace   Workspace? @relation("CurrentSession", fields: [currentWorkspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt]) // purge des sessions expirées
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        String    @default("admin") // "admin" | "editor" | "viewer"
  createdAt   DateTime  @default(now())

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
}

/// Pré-autorisation : « cet email aura ce rôle sur cet espace », posée AVANT que
/// la personne ait un compte. Elle devient une Membership toute seule à sa
/// première connexion (lib/invitations.ts > claimInvitations), puis la ligne est
/// SUPPRIMÉE — la Membership créée est la trace, on ne garde pas de `claimedAt`.
///
/// ⚠️ Ce n'est pas une Membership à `userId` nullable : rendre `userId` nullable
/// casserait @@unique([userId, workspaceId]), getMembership et les 5 check*Access.
/// Table séparée = zéro impact sur le chemin d'autorisation existant.
model WorkspaceInvitation {
  id            String         @id @default(cuid())
  /// Email NORMALISÉ (normalizeEmail) — sinon une invitation en casse mixte ne
  /// matcherait jamais la connexion qui la réclame.
  email         String
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role          String // "admin" | "editor" | "viewer" — jamais de @default : cf. Membership
  /// L'admin émetteur. SetNull comme Record.createdBy : supprimer un compte ne
  /// doit ni détruire l'invitation ni bloquer la suppression. ⚠️ C'est aussi le
  /// fil qui rattache l'invitation à une AUTORITÉ : perdre son rôle admin révoque
  /// ses invitations en attente (lib/workspace.ts > updateMemberRole/removeMember).
  invitedBy     String?
  inviter       User?          @relation("InvitationAuthor", fields: [invitedBy], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  /// Refus EXPLICITE de la personne visée. null = jamais refusée.
  /// ⚠️ Une invitation refusée n'est PAS supprimée : sans cette trace, l'admin
  /// voit « en attente » s'évanouir sans savoir si c'est un refus ou une
  /// expiration, et rien ne l'empêche de relancer quelqu'un qui a dit non.
  /// ⚠️ `hasPendingInvitation` DOIT l'exclure : sinon une invitation refusée
  /// continuerait de servir de laissez-passer au provisioning avec
  /// OIDC_ALLOW_SIGNUP=false — c'est de la sécurité, pas du confort.
  /// ⚠️ Ré-inviter (upsert sur la même ligne) doit la remettre à null.
  declinedAt    DateTime?
  notifications Notification[]

  @@unique([workspaceId, email])
  @@index([email]) // le claim interroge par email seul, à chaque connexion
  @@index([workspaceId])
  @@index([invitedBy])
}

model Workspace {
  id             String                @id @default(cuid())
  name           String                @default("Mon espace")
  createdAt      DateTime              @default(now())
  createdBy      String? // userId du créateur — ref uniquement, pas l'autorité
  memberships    Membership[]
  invitations    WorkspaceInvitation[]
  pages          Page[]
  sections       Section[]
  templates      Template[]
  activeSessions Session[]             @relation("CurrentSession")
  notifications  Notification[]
}

// Modèle réutilisable (façon Jira) : colonnes + regroupement kanban + sections de
// corps à libellés fixes. Appartient à un workspace. Les templates « fournis »
// (ticket, bug) sont définis en code (lib/templates.ts) à côté de ceux-ci.
model Template {
  id                  String    @id @default(cuid())
  workspaceId         String
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                String
  icon                String?
  columns             String    @default("[]") // JSON : PropertyPreset[]
  kanbanGroupProperty String? // nom de la colonne servant au regroupement kanban
  sections            String    @default("[]") // JSON : [{ id, label }]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([workspaceId])
}

model Section {
  id          String    @id @default(cuid())
  name        String
  type        String    @default("private") // "private" | "team"
  icon        String?
  position    Float     @default(0)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pages       Page[]

  @@index([workspaceId])
}

model Page {
  id          String    @id @default(cuid())
  title       String    @default("Sans titre")
  content     String    @default("[]")
  icon        String?
  parentId    String?
  parent      Page?     @relation("PageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Page[]    @relation("PageTree")
  // Float sans contrainte d'unicité : gap-based ordering
  position    Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Renseigné UNIQUEMENT sur les pages racines (parentId IS NULL).
  // Ne jamais écrire directement — passer par lib/pages.ts > setPageSection().
  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  // Créateur de la page. Toujours renseigné à la création via lib/pages.ts > createPage().
  // Pour les pages privées (visibility="private"), filtre WHERE ownerId = currentUserId.
  ownerId String?
  owner   User?   @relation("PageOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  // Dénormalisé depuis la section racine ("private" | "team").
  // Synchronisé à la création et au déplacement via lib/pages.ts > setPageSection().
  // Pour les pages enfants, copié depuis le parent à la création via createPage().
  visibility String @default("team")

  // Corbeille (soft delete). null = active. Trasher une page estampe tout son
  // sous-arbre (cf. lib/trash.ts) ; purge automatique après 30 j.
  trashedAt DateTime?

  database Database?
  visits   PageVisit[]

  @@index([parentId])
  // Composite : les pages sont listées par workspace et triées par position (sidebar).
  @@index([workspaceId, position])
  @@index([sectionId])
  @@index([ownerId])
  @@index([visibility])
  @@index([trashedAt])
}

model PageVisit {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  visitedAt DateTime @default(now())

  @@unique([userId, pageId]) // upsert à chaque visite, pas insert
  @@index([userId])
  @@index([pageId])
}

model Database {
  id               String             @id @default(cuid())
  pageId           String             @unique
  page             Page               @relation(fields: [pageId], references: [id], onDelete: Cascade)
  properties       DatabaseProperty[]
  records          Record[]
  views            View[]
  sprints          Sprint[]
  // Modèle de corps LIBRE (document BlockNote JSON) pré-rempli à la création d'un
  // record quand aucun `content` n'est fourni. null = pas de modèle.
  recordTemplate   String?
  // Template (sections + colonnes) depuis lequel la database a été scaffoldée.
  // Référence un id de Template OU un id de template fourni ("builtin-…").
  templateId       String?
  // Squelette de sections estampé sur les nouveaux records (JSON [{id,label}]).
  // Copié du template à la création → robuste si le template change/disparaît.
  recordSections   String?
  // Page « 📓 Patch notes » où les notes de version sont auto-appendées à la clôture
  // d'un sprint (Ticket 8). Référence LIBRE (pas de relation Prisma) : éviter une
  // 2e relation nommée Page↔Database ; la robustesse est assurée à l'append (page
  // existante + même workspace, sinon flag « non appendé »). null = pas de mapping
  // → la clôture réussit quand même, avec un flag explicite dans la réponse.
  patchNotesPageId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model DatabaseProperty {
  id         String   @id @default(cuid())
  databaseId String
  database   Database @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  name       String
  type       String
  position   Float    @default(0)
  config     String   @default("{}")

  // Composite : les colonnes sont TOUJOURS lues filtrées par databaseId ET triées
  // par position (cf. lib/positions.ts). Couvre aussi le filtre databaseId seul.
  @@index([databaseId, position])
}

model Record {
  id           String   @id @default(cuid())
  databaseId   String
  database     Database @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  title        String   @default("Sans titre")
  icon         String?
  coverUrl     String?
  content      String   @default("[]")
  createdBy    String?
  creator      User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  position     Float    @default(0)
  properties   String   @default("{}")
  // Corps SECTIONNÉ (templates à libellés fixes). JSON : [{ id, label, content }]
  // où content est un document BlockNote. null = corps libre (champ `content`).
  templateId   String?
  sectionsBody String?

  // Sprint d'affectation (vue backlog façon Jira). null = backlog (non planifié).
  // onDelete SetNull : supprimer un sprint renvoie ses issues au backlog.
  sprintId String?
  sprint   Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  // Corbeille (soft delete). null = actif ; purge automatique après 30 j.
  trashedAt DateTime?

  // Piste d'audit qui/quoi/quand des modifications (onglet Historique de la carte).
  revisions RecordRevision[]

  // Pièces jointes (documents déposés sur la carte).
  attachments RecordAttachment[]

  // Fil de discussion de la carte (append-only).
  comments RecordComment[]

  // Composite : les records sont lus filtrés par databaseId ET triés par position.
  @@index([databaseId, position])
  @@index([createdBy])
  @@index([sprintId])
  @@index([trashedAt])
}

// Commentaire sur une carte : une remarque datée, signée, qu'on ajoute sans
// toucher au corps.
//
// ⚠️ APPEND-ONLY, comme RecordRevision et Notification : pas d'updatedAt, pas de
// deletedAt, aucune route de modification ni de suppression. Décision de Gautier
// du 09/08 (« pas de suppression des commentaires ni modification »). Un fil
// qu'on peut réécrire n'est plus une trace ; et l'absence de ces deux routes
// supprime avec elles la question « qui a le droit », la modale de confirmation
// et la mention « modifié ».
//
// ⚠️ Le corps est du TEXTE BRUT, pas du BlockNote. Un document BlockNote n'a
// aucun aperçu lisible (l'onglet Historique y renonce et affiche « Contenu mis à
// jour »), exige un éditeur client-only par commentaire, et se fabrique
// péniblement côté serveur — or le pont MCP écrit dans ce champ.
//
// ⚠️ La grande raison d'être : Record.content et Record.sectionsBody s'écrivent
// en REMPLACEMENT TOTAL. Une remarque posée dans le corps risque d'être effacée
// par la mise à jour suivante — c'est le piège documenté des « 🗣️ Notes de
// Gautier ». Ici chaque message a sa ligne.
model RecordComment {
  id       String @id @default(cuid())
  recordId String
  record   Record @relation(fields: [recordId], references: [id], onDelete: Cascade)

  // Texte brut, borné à 4000 caractères par la route.
  body String

  // SetNull : supprimer un compte ne détruit pas ce qu'il a écrit. L'affichage
  // dégrade en « Quelqu'un », comme les notifications.
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  // ⚠️ Date de PUBLICATION, jamais rafraîchie — contrairement à
  // RecordRevision.createdAt, que la coalescence réécrit. Un commentaire ne
  // coalesce pas : chaque message est un fait daté.
  createdAt DateTime @default(now())

  @@index([recordId, createdAt])
  @@index([authorId])
}

// Pièce jointe d'une carte : un document déposé dessus (contrat, devis, export…).
//
// ⚠️ Le FICHIER vit sur disque (UPLOAD_DIR), cette ligne n'en porte que la
// référence. Deux lignes peuvent citer le MÊME fileName — c'est ce qui rend la
// duplication d'une carte gratuite. Le comptage de références est fait par
// purgeOrphanUploads, qui recalcule l'ensemble des noms cités à chaque passage :
// un fichier cité par zéro ligne ET vieux de 30 j est supprimé du disque.
//
// ⚠️ AUCUN trashedAt : seuls Page et Record en ont un. Retirer une pièce jointe
// est DÉFINITIF, et l'écran le dit. Un deletedAt n'achèterait rien ici — la
// purge borne sur l'âge du FICHIER, pas sur la date de retrait : un document
// joint il y a six mois et détaché par erreur serait supprimé au prochain
// passage, et seuls ceux qu'on vient de poser survivraient. Décision de Gautier
// du 08/08.
model RecordAttachment {
  id       String @id @default(cuid())
  recordId String
  record   Record @relation(fields: [recordId], references: [id], onDelete: Cascade)

  // Nom sur disque : `<uuid>.<ext>`, servi par GET /api/attachments/[id].
  // ⚠️ JAMAIS d'URL ici, seulement le nom : la purge lit ce champ DIRECTEMENT,
  // sans passer par extractUploadRefs (dont la regex attend « /api/files/… » et
  // rendrait un ensemble vide — donc purgerait tout).
  fileName String
  // Nom d'origine choisi par la personne, affiché à l'écran et au téléchargement.
  // POST /api/upload le jette : sans ce champ, la carte montrerait un UUID.
  name     String
  mimeType String
  size     Int

  uploadedBy String?
  uploader   User?   @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([recordId, createdAt])
  @@index([fileName])
  @@index([uploadedBy])
}

// Historique des modifications d'un record (piste d'audit qui/quoi/quand).
// UNE ligne par CHAMP effectivement changé (title / content / sectionsBody /
// DatabaseProperty.id / RecordSection.id), écrite côté serveur dans
// PATCH /api/records/[id]. Coalescence 2 min (même acteur + même champ) pour
// absorber le spam d'autosave BlockNote. Rétention indéfinie (PAS de purge,
// contrairement au trashedAt des records). Périmètre records uniquement (v1).
model RecordRevision {
  id        String   @id @default(cuid())
  recordId  String
  record    Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  // Acteur = utilisateur de la session au moment du PATCH. SetNull : supprimer un
  // User ne détruit pas la trace (l'auteur devient inconnu, la révision demeure).
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  // Champ touché : "title" | "content" | "sectionsBody" | DatabaseProperty.id | RecordSection.id
  field     String
  before    String // JSON de l'ancienne valeur (null sérialisé si absente)
  after     String // JSON de la nouvelle valeur
  // Rafraîchi lors d'une fusion (coalescence) → base de la fenêtre de 2 min.
  createdAt DateTime @default(now())

  @@index([recordId, createdAt])
  @@index([recordId, field])
}

// Sprint (vue backlog façon Jira). Lié à une Database. Les records y sont
// rattachés via Record.sprintId (null = backlog). state : "future" planifié,
// "active" en cours, "completed" terminé (sort du board, conserve ses records).
model Sprint {
  id           String    @id @default(cuid())
  databaseId   String
  database     Database  @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  name         String    @default("Sprint")
  goal         String?
  startDate    DateTime?
  endDate      DateTime?
  state        String    @default("future") // "future" | "active" | "completed"
  // Notes de version (patch notes) générées à la clôture depuis les issues
  // livrées. Lecture seule côté UI. null = pas encore générées.
  releaseNotes String?
  position     Float     @default(0)
  records      Record[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Composite : les sprints sont lus filtrés par databaseId ET triés par position.
  @@index([databaseId, position])
}

model View {
  id         String   @id @default(cuid())
  databaseId String
  database   Database @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  name       String   @default("Vue")
  type       String   @default("table") // "table" | "kanban" | "calendar" | "gallery" | "backlog"
  position   Float    @default(0)
  config     String   @default("{}")
  createdAt  DateTime @default(now())

  // Composite : les vues sont lues filtrées par databaseId ET triées par position.
  @@index([databaseId, position])
}

// Réglages globaux de l'instance (self-host mono-instance). Ligne UNIQUE (id "app").
model AppConfig {
  id          String   @id @default("app")
  // Taille max d'un fichier uploadé, en Mo. Modifiable dans Paramètres.
  uploadMaxMb Int      @default(10)
  updatedAt   DateTime @updatedAt
}

/// Jeton de connexion par email (« lien magique »).
///
/// Même doctrine que Session : `id = sha256(token)`, le jeton en clair ne vit
/// que dans le lien envoyé — une fuite de la base ne donne aucun accès.
///
/// PAS de relation vers User, à dessein : un invité peut n'avoir aucun compte
/// au moment où il demande son lien. C'est la consommation qui crée le compte,
/// une fois la possession de l'adresse prouvée par le clic.
model LoginToken {
  id        String   @id
  /// Email normalisé (trim + minuscules), comme partout ailleurs.
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt]) // purge des jetons expirés
}

/// Notification in-app (cloche de l'en-tête). C'est un MESSAGE, JAMAIS une
/// AUTORISATION : l'autorité d'une invitation reste WorkspaceInvitation, celle
/// d'un accès reste Membership. Une notification purgée, non lue ou jamais
/// affichée ne doit donc RIEN changer aux droits — sans cette règle, la purge
/// paresseuse révoquerait des accès en silence.
///
/// Append-only comme RecordRevision : pas d'updatedAt, pas de trashedAt. Une
/// notification est un FAIT daté ; seul readAt bouge.
model Notification {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  /// "workspace_invitation" | "workspace_joined" | "invitation_declined"
  /// | "role_changed" | "membership_removed" — String, jamais un enum (cf.
  /// Membership.role, Sprint.state). Un type INCONNU doit dégrader en ligne
  /// générique, jamais planter : un retour arrière du code laisse en base des
  /// lignes déjà écrites.
  type         String
  /// Cascade : supprimer un espace ne doit pas laisser des notifications qui
  /// afficheraient « Espace inconnu ». ⚠️ Sa présence ne PROUVE aucune
  /// appartenance — une invitation vise justement un espace dont on n'est pas
  /// encore membre.
  workspaceId  String?
  workspace    Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// SetNull comme RecordRevision.actorId : supprimer un compte ne détruit pas
  /// la trace, l'acteur devient « Utilisateur inconnu ».
  actorId      String?
  actor        User?                @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// SEULE vraie relation vers une cible, parce que c'est la seule qui porte un
  /// BOUTON qui donne un accès. Cascade : révoquer, consommer ou purger
  /// l'invitation fait disparaître la carte — un « Accepter » ne survit jamais
  /// à l'invitation qui le justifie.
  invitationId String?
  invitation   WorkspaceInvitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  /// Instantané JSON des LIBELLÉS à l'émission (workspaceName…) + références
  /// LIBRES. Repli d'affichage quand la cible a disparu. JAMAIS de donnée
  /// d'autorisation : le rôle offert vit sur l'invitation, qui change au
  /// ré-invite. Parsé par lib/notifications.ts, jamais de JSON.parse en route.
  payload      String               @default("{}")
  /// null = non lu — même grammaire que trashedAt: null = actif. Une date
  /// plutôt qu'un booléen : « tout marquer lu » = un updateMany, et on sait
  /// quand ; un booléen exigerait une 2e colonne pour la même question.
  readAt       DateTime?
  createdAt    DateTime             @default(now())

  /// Ré-inviter fait un UPSERT sur la MÊME ligne d'invitation : sans cette clé,
  /// chaque relance empilerait une carte « Accepter » de plus. Les NULL restent
  /// distincts en SQLite, donc les notifications sans invitation ne sont pas
  /// contraintes.
  @@unique([userId, invitationId])
  /// Requête CHAUDE : le compteur de non-lus, sondé sur toutes les pages.
  @@index([userId, readAt])
  /// Liste du panneau, du plus récent au plus ancien (cf. RecordRevision).
  @@index([userId, createdAt])
  /// Balayage de purge global — cf. @@index([expiresAt]) de Session.
  @@index([createdAt])
  @@index([workspaceId])
  @@index([actorId])
  @@index([invitationId])
}
