# Variables d'environnement de gotyeah-notes.
# Copie ce fichier en `.env` (NON committé) et renseigne tes valeurs :
#   cp .env.example .env
# Le `.env` est lu par Prisma en local (via `dotenv` dans prisma.config.ts) et par
# Docker Compose au déploiement (interpolation ${...} dans docker-compose.yml).

# --- Base de données (Prisma / SQLite) ---
# Requis en LOCAL (npm run dev, db:push, db:studio). En conteneur, la valeur est déjà
# fixée par le Dockerfile / docker-compose (file:/data/dev.db) → inutile de la mettre
# côté Pi. Astuce : pointer la DB HORS du dossier projet évite que le watcher de
# `next dev` ne coupe les écritures SQLite (cf. CLAUDE.md > Bugs connus).
DATABASE_URL="file:./dev.db"

# --- Pont MCP (serveur MCP distant Sonar → API gotyeah-notes) ---
# Secret partagé du « sous-système de confiance » (cf. src/lib/session.ts) : le MCP,
# déjà authentifié par l'IdP, agit au nom d'un user via X-MCP-Secret + X-Act-As-Email.
# DOIT être IDENTIQUE à NOTES_MCP_SECRET côté Sonar. Vide = chemin act-as DÉSACTIVÉ
# (aucune surface ajoutée). Surtout pertinent sur le Pi (prod), où le compose lit
# ${MCP_SHARED_SECRET}. Génère-le avec :  openssl rand -hex 32
MCP_SHARED_SECRET=

# Allowlist optionnelle des emails que le pont MCP peut incarner (séparés par des
# virgules). Vide = comportement historique (n'importe quel User existant). Définie =
# seuls ces emails sont acceptés, les autres sont refusés + journalisés.
MCP_ACT_AS_ALLOWLIST=

# --- Sécurité / auth (lot durcissement) ---
# Inscription publique par formulaire (POST /api/auth/register). "off" par défaut
# (instance privée) ; "on" pour rouvrir. Découplé de LEGACY_LOGIN et de l'OIDC.
REGISTRATION=off
# Login email/mot de passe. "on" par défaut ; "off" = « comptes GotYeah (OIDC) uniquement ».
LEGACY_LOGIN=on

# --- Connexion OIDC (bouton « Se connecter avec GotYeah ») ---
# Flux Authorization Code + PKCE piloté par le backend ; le callback crée la session
# applicative habituelle (cookie httpOnly), aucun token côté client (cf. src/lib/oidc.ts).
# Les 4 premières doivent être TOUTES renseignées : si une seule manque, oidcEnabled()
# renvoie false et le bouton OIDC est simplement masqué (pas d'erreur).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Aussi utilisé comme ORIGINE PUBLIQUE de l'app (appOrigin()) pour construire les
# redirections : derrière NPM/Cloudflare, l'origine de la requête interne n'est pas
# publique. Doit donc être l'URL publique exacte, pas une adresse de conteneur.
OIDC_REDIRECT_URI=

# Créer automatiquement un User au premier login OIDC.
#   "true"  = tout compte de l'IdP obtient un compte ici. À n'utiliser que si le
#             realm/tenant de l'IdP est DÉDIÉ à cette instance.
#   "false" = provisioning sur INVITATION seule : le compte n'est créé que si
#             l'adresse a une invitation vivante (cf. Réglages → Membres). Les
#             comptes déjà existants se connectent normalement.
# Le défaut du CODE est "true" (self-host simple) ; docker-compose retombe sur
# "false". ⚠️ Poser "false" ici si l'IdP est PARTAGÉ avec d'autres applications :
# sinon leurs utilisateurs se créent un compte en cliquant « Se connecter ».
# Indépendant de REGISTRATION (qui ne concerne que le formulaire d'inscription).
OIDC_ALLOW_SIGNUP=false

# Libellé du bouton sur la page de login. Défaut : "Se connecter avec GotYeah".
OIDC_BUTTON_LABEL=

# --- Uploads (images collées dans l'éditeur) ---
# Dossier de stockage des fichiers servis par /api/files/<nom>. Défaut : ./data/uploads
# (relatif au cwd) — suffisant en local. En conteneur, DOIT pointer sur le volume
# persistant (/data/uploads, déjà fixé par docker-compose) : hors volume, les images
# disparaissent au premier rebuild. À inclure dans les sauvegardes en plus de dev.db.
UPLOAD_DIR=

# --- Envoi d'emails (invitations) — API HTTP Brevo ---
# VIDE = envoi DÉSACTIVÉ, et c'est un mode légitime : les invitations sont créées
# normalement, mais personne n'est prévenu (l'écran Membres le dit). Même patron
# que MCP_SHARED_SECRET : pas de clé, pas de surface.
BREVO_API_KEY=

# Expéditeur. DOIT être un expéditeur (ou un domaine) VÉRIFIÉ côté Brevo, sinon
# l'API répond 400 et rien ne part. Défaut : notes@localhost.
MAIL_FROM=
MAIL_FROM_NAME=

# Origine publique utilisée pour le lien des emails, ex. https://notes.example.com
# Vide = repli sur l'origine dérivée de OIDC_REDIRECT_URI (appOrigin()).
# ⚠️ Ne jamais dériver ce lien de l'en-tête Host d'une requête : il est contrôlé
# par l'appelant, et un email GotYeah pointant ailleurs est un hameçonnage.
APP_BASE_URL=

# --- Provisioning des invités dans l'IdP (Keycloak) ---
# Permet à notes de CRÉER le compte Keycloak d'un invité, sans ouvrir
# l'auto-inscription du realm (qui est partagé par tous les sites).
# VIDES = fonctionnalité désactivée : l'invitation marche, mais il faut créer le
# compte à la main dans la console Keycloak.
#
# ⚠️ Le client doit être DÉDIÉ et MINIMAL : « Client authentication » ON,
# « Standard flow » OFF, « Service accounts roles » ON, et un seul rôle assigné —
# realm-management > manage-users. JAMAIS realm-admin : ce secret vit dans une
# application web, pas dans une console d'administration.
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
